# Copy this file to .env (never commit .env).
# Long random string used to sign sessions. Create one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If it is empty, a key is generated once and saved in instance/.secret_key.
SECRET_KEY=

# Optional. Defaults to sqlite:///ppia.db (stored in instance/).
# DATABASE_URL=sqlite:///ppia.db
